<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lidar_test_world">

    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" 
            name="gz::sim::systems::UserCommands"/>

    <!-- Земля -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>0 0 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>

    <!-- Объекты для сканирования (с цветами) -->
    
    <!-- Красный кубик слева -->
    <model name="box_left">
      <pose>-1.5 0 0.5 0 0 0</pose>
      <link name="box_left_link">
        <inertial>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
          <mass>1.0</mass>
        </inertial>
        <collision name="box_left_collision">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_left_visual">
          <geometry>
            <box>
              <size>0.8 0.8 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Зелёный кубик справа -->
    <model name="box_right">
      <pose>2.0 -1.0 0.5 0 0 0</pose>
      <link name="box_right_link">
        <inertial>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
          <mass>1.0</mass>
        </inertial>
        <collision name="box_right_collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="box_right_visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Синяя сфера сзади -->
    <model name="sphere_back">
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="sphere_link">
        <collision name="collision">
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
        </collision>
        <visual name="sphere_visual">
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>
    </model>

    <!-- Модель с лидаром (статическая, без инерции, только визуал) -->
    <model name="lidar_station" static="true">
      <pose>0 0 0 0 0 0</pose>
      <link name="laser_link">
        <pose>0 0 0.3 0 0 0</pose>
        <visual name="laser_visual">
          <geometry>
            <cylinder>
              <radius>0.06</radius>
              <length>0.03</length>
            </cylinder> 
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>   <!-- серый -->
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="laser_collision">
          <geometry>
            <cylinder radius="0.06" length="0.03"/>
          </geometry>
        </collision>

        <!-- Сенсор лидара прикреплён к этой ссылке -->
        <sensor name="lidar" type="gpu_lidar">
          <topic>/lidar/scan</topic>
          <update_rate>10</update_rate>
          <ignition_frame_id>laser_link</ignition_frame_id>
          <lidar>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1.0</resolution>
                <min_angle>-0.0</min_angle>
                <max_angle>0.0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>1.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

    </model>
  </world>
</sdf>