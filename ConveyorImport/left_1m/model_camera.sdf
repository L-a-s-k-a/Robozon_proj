<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="left_1m">
    <static>false</static>

    <link name="link">
      <collision name="collision">
        <pose>0 0 0.597456 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://left_1m/meshes/col_left_1m.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0.597456 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://left_1m/meshes/left_1m.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      
      <!-- Add inertial tag to main link if not already present -->
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>10</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>10</iyy>
          <iyz>0</iyz>
          <izz>10</izz>
        </inertia>
      </inertial>
    </link>

    <!-- ==================== CAMERA LINK ==================== -->
    <link name="camera_link">
      <pose>0.7 0 0.9 0 0 3.140</pose>
      <inertial>
        <mass>0.0</mass>
        <inertia>
          <ixx>0.000</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000</iyy>
          <iyz>0</iyz>
          <izz>0.000</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>

      <!-- The camera sensor itself -->
      <sensor name="camera_sensor" type="camera">
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>720</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>camera/image_raw</topic>
        <gz_frame_id>camera_link_optical</gz_frame_id>
      </sensor>
    </link>

    <!-- ==================== CAMERA OPTICAL FRAME ==================== -->
    <link name="camera_link_optical">
      <pose>0 0 0 0 0 0</pose>
    </link>

    <!-- ==================== LIGHT LINKS (Zero mass, kinematic, no collision) ==================== -->
    <link name="light_link1">
      <pose>-1.5 0.3 0.9 -0.4 -1.41 0</pose>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.0</mass>
        <inertia>
          <ixx>0.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0</iyy>
          <iyz>0.0</iyz>
          <izz>0.0</izz>
        </inertia>
      </inertial>
      <!-- No collision tag = no physical interaction -->
      <light name="spot_light1" type="spot">
        <cast_shadows>false</cast_shadows>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
          <range>10</range>
          <constant>0.2</constant>
          <linear>0.01</linear>
          <quadratic>0</quadratic>
        </attenuation>
        <direction>0 0 -1</direction>
        <spot>
          <inner_angle>0.1</inner_angle>
          <outer_angle>0.5</outer_angle>
          <falloff>1.2</falloff>
        </spot>
      </light>
    </link>

    <link name="light_link2">
      <pose>-1.5 -0.8 0.9 0.4 -1.41 0</pose>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.0</mass>
        <inertia>
          <ixx>0.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0</iyy>
          <iyz>0.0</iyz>
          <izz>0.0</izz>
        </inertia>
      </inertial>
      <!-- No collision tag = no physical interaction -->
      <light name="spot_light2" type="spot">
        <cast_shadows>false</cast_shadows>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
          <range>10</range>
          <constant>0.2</constant>
          <linear>0.01</linear>
          <quadratic>0</quadratic>
        </attenuation>
        <direction>0 0 -1</direction>
        <spot>
          <inner_angle>0.1</inner_angle>
          <outer_angle>0.5</outer_angle>
          <falloff>1.2</falloff>
        </spot>
      </light>
    </link>

    <!-- ==================== JOINTS ==================== -->
    <!-- Fixed joint: attaches camera to the main body -->
    <joint name="camera_joint" type="fixed">
      <parent>link</parent>
      <child>camera_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- Fixed joint: optical frame (rotates to camera convention: Z forward) -->
    <joint name="camera_optical_joint" type="fixed">
      <parent>camera_link</parent>
      <child>camera_link_optical</child>
      <pose>0 0 0 -1.5708 0 -1.5708</pose>
    </joint>

    <!-- Fixed joint: attaches light_link1 to the main body -->
    <joint name="light_joint1" type="fixed">
      <parent>link</parent>
      <child>light_link1</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- Fixed joint: attaches light_link2 to the main body -->
    <joint name="light_joint2" type="fixed">
      <parent>link</parent>
      <child>light_link2</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

  </model>
</sdf>
