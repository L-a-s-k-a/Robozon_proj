<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="plate">
    <static>false</static>
    <link name="link">
      <collision name="collision">
        <!-- Offset applied here to align feet to ground -->
        <pose>0 0 0 1.41 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://plate/meshes/plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <!-- Offset applied here to align feet to ground -->
        <pose>0 0 0 1.41 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://plate/meshes/plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
